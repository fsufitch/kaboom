{
  "name": "kaboomchess",
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      "USERNAME": "${localEnv:USER}" // host username into build
    }
  },
  // Tell VS Code which user to run as
  "remoteUser": "${localEnv:USER}",
  "containerUser": "${localEnv:USER}",
  // On Linux, adjust UID/GID to match your host user
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "protobuf.protoc.path": "/usr/bin/protoc"
      },
      "extensions": [
        "eamodio.gitlens",
        "foxundermoon.shell-format",
        "ms-azuretools.vscode-docker",
        "wdhongtw.gpg-indicator",
        "yzhang.markdown-all-in-one",
        "EditorConfig.EditorConfig",
        "DrBlury.protobuf-vsc",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools-extension-pack",
        "Anthropic.claude-code"
      ]
    }
  },
  // "updateContentCommand": {
  //   "nodeInstall": "pnpm install"
  // }
}