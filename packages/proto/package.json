{
  "name": "@kaboom/proto",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.cjs",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm generate",
    "build": "tsup --config tsup.config.ts",
    "generate": "bash ./protobuf_ts.sh build",
    "clean": "bash ./protobuf_ts.sh clean",
    "lint": "pnpm -C ../.. exec eslint --config packages/proto/eslint.config.ts packages/proto",
    "lint:fix": "pnpm -C ../.. exec eslint --config packages/proto/eslint.config.ts packages/proto --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "protoc": "^33.2.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "ts-proto": "^2.10.1"
  }
}
