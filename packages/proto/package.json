{
  "name": "@kaboom/proto",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./gen/*": {
      "import": "./dist/gen/*.js",
      "types": "./dist/gen/*.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm generate",
    "build": "tsc --build",
    "generate": "bash ./protobuf_ts.sh build",
    "clean": "bash ./protobuf_ts.sh clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "protoc": "^33.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "ts-proto": "^2.10.1"
  }
}
