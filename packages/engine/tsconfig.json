{
  "extends": [
    "../../tsconfig.base.json",
  ],
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@kaboom/engine/*": [
        "./src/*"
      ],
      "@kaboom/proto": [
        "../proto/src/index.ts"
      ],
      "@kaboom/proto/*": [
        "../proto/src/*"
      ]
    }
  },
  "exclude": [
    "dist",
    "node_modules",
    "eslint.config.ts",
  ]
}
