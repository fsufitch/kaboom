    "@eslint/js": "^9.39.2",
    "@eslint/markdown": "^7.5.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "@types/node": "^25.0.3",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
