{
  "name": "kaboomchess",
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      "USERNAME": "${localEnv:USER}" // host username into build
    }
  },
  // Tell VS Code which user to run as
  "remoteUser": "${localEnv:USER}",
  "containerUser": "${localEnv:USER}",
  // On Linux, adjust UID/GID to match your host user
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "protobuf.protoc.path": "/usr/bin/protoc"
      },
      "extensions": [
        "eamodio.gitlens",
        "foxundermoon.shell-format",
        "ms-azuretools.vscode-docker",
        "wdhongtw.gpg-indicator",
        "yzhang.markdown-all-in-one",
        "EditorConfig.EditorConfig",
        "zxh404.vscode-proto3",
        "openai.chatgpt",
        "rvest.vs-code-prettier-eslint",
        "esbenp.prettier-vscode",
        "DrBlury.protobuf-vsc"
      ]
    }
  },
  "updateContentCommand": {
    "nodeInstall": "npm install"
  }
}
