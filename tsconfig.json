{
  "compilerOptions": {
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "esnext",
    "target": "es2019",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": [
      "ES2019"
    ],
    "types": [
      "node",
    ],
    "baseUrl": ".",
    "paths": {
      "@kaboom/*": [
        "./src/kaboom/*"
      ]
    },
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "eslint.config.ts"
  ]
}
