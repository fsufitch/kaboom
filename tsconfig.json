{
  "compilerOptions": {
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "module": "commonjs",
    "target": "es6",
    "moduleResolution": "node10",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node",
    ],
    "baseUrl": ".",
    "paths": {
      "@kaboom/*": [
        "./src/kaboom"
      ]
    },
  },
  "include": [
    "src/**/*.ts",
  ],
}