{
  "name": "@kaboom/root",
  "version": "0.0.1",
  "private": true,
  "description": "Kaboom is a stateless chess rules engine that runs entirely on data you provide. It understands multiple rulesets (the `classic` chess ruleset is currently implemented) and exposes a set of pure functions that turn moves into validated effects without keeping server-side session state.",
